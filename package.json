{
  "name": "limoxis-observer",
  "private": true,
  "version": "0.47.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tools/**/*.mjs\" \"tests/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tools/**/*.mjs\" \"tests/**/*.{js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run audit:clinical-i18n && npm run audit:lab-i18n && npm run audit:product-i18n && npm run audit:english-parity && npm run audit:help-coverage && npm run audit:product-permissions && npm run audit:navigation && npm run audit:hooks && npm run audit:frontend-parity && npm run audit:observer-ui && npm run lint && npm run test && npm run build",
    "audit:clinical-i18n": "node tools/check-clinical-i18n.mjs",
    "audit:lab-i18n": "node tools/check-lab-i18n.mjs",
    "audit:product-i18n": "node tools/check-product-i18n.mjs",
    "audit:product-permissions": "node tools/check-product-permissions.mjs",
    "audit:navigation": "node tools/check-navigation-smoke.mjs",
    "audit:hooks": "node tools/check-react-hooks-smoke.mjs",
    "audit:frontend-parity": "node tools/check-frontend-parity.mjs",
    "audit:observer-ui": "node tools/check-observer-ui-patterns.mjs",
    "audit:english-parity": "node tools/check-english-parity.mjs",
    "audit:help-coverage": "node tools/check-help-manual-coverage.mjs",
    "report:english-ui": "node tools/report-english-ui-risk.mjs",
    "test:lira": "vitest run tests/liraQuestionModel.test.js tests/liraHaiMetrics.test.js tests/liraOperationalOverview.test.js tests/liraPhase1Core.test.js tests/liraKnowledgeFoundation.test.js tests/liraClinicalCurriculum.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "buildStamp": "2026-09-18-lab-isolate-polish"
}
