{
  "name": "limoxis-observer",
  "private": true,
  "version": "0.47.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run audit:clinical-i18n && npm run audit:lab-i18n && npm run audit:product-i18n && npm run audit:english-parity && npm run audit:help-coverage && npm run audit:product-permissions && npm run audit:db-roles && npm run audit:security-definer && npm run audit:navigation && npm run audit:hooks && npm run audit:frontend-parity && npm run audit:observer-ui && npm run audit:dead-css && npm run audit:important-count && npm run typecheck:strict && npm run typecheck:tests && npm run lint && npm run test && npm run build && npm run audit:dead-selectors",
    "audit:clinical-i18n": "node tools/check-clinical-i18n.ts",
    "audit:lab-i18n": "node tools/check-lab-i18n.ts",
    "audit:product-i18n": "node tools/check-product-i18n.ts",
    "audit:product-permissions": "node --import ./tools/ts/register.ts tools/check-product-permissions.ts",
    "audit:db-roles": "node --import ./tools/ts/register.ts tools/check-db-role-alignment.ts",
    "audit:security-definer": "node tools/check-security-definer.ts",
    "audit:navigation": "node tools/check-navigation-smoke.ts",
    "audit:hooks": "node tools/check-react-hooks-smoke.ts",
    "audit:frontend-parity": "node tools/check-frontend-parity.ts",
    "audit:observer-ui": "node tools/check-observer-ui-patterns.ts",
    "audit:dead-css": "node tools/check-dead-css.ts",
    "audit:important-count": "node tools/check-important-count.ts",
    "css:prune": "node tools/check-dead-css.ts --write",
    "visual:compare": "node tools/visual-regression.ts",
    "audit:a11y": "node tools/check-accessibility.ts",
    "audit:english-parity": "node tools/check-english-parity.ts",
    "audit:help-coverage": "node --import ./tools/ts/register.ts tools/check-help-manual-coverage.ts",
    "report:english-ui": "node tools/report-english-ui-risk.ts",
    "test:lira": "vitest run tests/liraQuestionModel.test.ts tests/liraHaiMetrics.test.ts tests/liraOperationalOverview.test.ts tests/liraPhase1Core.test.ts tests/liraKnowledgeFoundation.test.ts tests/liraDemoReadiness.test.ts tests/liraLauncherLoading.test.ts tests/liraKnowledgeWorkflow.test.ts tests/liraGateway.test.ts tests/liraProviderSettings.test.ts tests/liraProviderRuntime.test.ts tests/liraRagRuntime.test.ts",
    "audit:dead-selectors": "node tools/check-dead-selectors.ts",
    "manual:pdf": "node --import ./tools/ts/register.ts tools/build-manual-pdf.ts",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "typecheck:tests": "node tools/check-test-types.ts",
    "manual:screens": "node tools/capture-manual-screens.ts",
    "screens:matrix": "node tools/capture-screen-matrix.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "buildStamp": "2026-09-18-lab-isolate-polish"
}
